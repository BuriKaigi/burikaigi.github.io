---
import Layout from '~/layouts/2027Sub.astro';
import type { NewsFrontmatter } from '~/types/news';

interface Props {
  frontmatter: NewsFrontmatter;
}

const { frontmatter } = Astro.props;

const pathWithSlash = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const shareUrl = Astro.site
  ? new URL(pathWithSlash, Astro.site).toString()
  : Astro.url.toString();
const shareIntent = `https://twitter.com/intent/tweet?text=${encodeURIComponent(
  frontmatter.title
)}&url=${encodeURIComponent(shareUrl)}&hashtags=burikaigi`;
---

<Layout
  name={frontmatter.title}
  ogTitle={frontmatter.title}
  ogType="article"
  ogDescription={frontmatter.summary}
  publishedTime={`${frontmatter.date}T00:00:00+09:00`}
>
  <article>
    <header class="article-head">
      <h1>{frontmatter.title}</h1>
      <time datetime={frontmatter.date}>{frontmatter.date.replaceAll('-', '.')}</time>
    </header>

    <div class="news-body">
      <slot />
    </div>

    <footer class="article-foot">
      <a class="btn ghost" href="/news/">← お知らせ一覧</a>
      <a class="btn primary" href={shareIntent} target="_blank" rel="noopener noreferrer" aria-label="この記事を X でシェア">
        <img src="/images/x.svg" alt="" width="16" height="16" aria-hidden="true" />
        この記事をシェア
      </a>
    </footer>
  </article>
</Layout>

<style>
  article {
    max-width: 760px;
    margin: 0 auto;
  }

  .article-head {
    padding-bottom: 24px;
    border-bottom: 2px solid var(--ai);
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(24px, 3.4vw, 36px);
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--ai);
  }
  time {
    display: block;
    margin-top: 12px;
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--kin-deep);
  }

  .article-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  /* 白抜きの X ロゴ */
  .article-foot img {
    width: 16px;
    height: 16px;
    filter: invert(1);
  }

  /* Markdown 本文。要素は Markdown から生成されるので :global で当てる */
  .news-body {
    font-size: 16px;
  }
  .news-body :global(h2) {
    margin: 2.5em 0 0.8em;
    padding-left: 14px;
    border-left: 4px solid var(--kin);
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.5;
    color: var(--ai);
  }
  .news-body :global(h3) {
    margin: 2em 0 0.6em;
    font-family: var(--display);
    font-weight: 800;
    font-size: 18px;
    color: var(--ai);
  }
  .news-body :global(p) {
    margin: 1em 0 0;
    line-height: 1.95;
  }
  .news-body :global(strong) {
    font-weight: 700;
    color: var(--ai);
  }
  .news-body :global(a) {
    color: var(--ai);
    text-decoration: underline;
    text-decoration-color: var(--kin);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .news-body :global(a:hover) {
    background: var(--washi);
  }
  .news-body :global(ul),
  .news-body :global(ol) {
    margin: 1em 0 0;
    padding-left: 1.5em;
  }
  .news-body :global(ul) {
    list-style: disc;
  }
  .news-body :global(ol) {
    list-style: decimal;
  }
  .news-body :global(li) {
    margin-top: 0.4em;
  }
  .news-body :global(li::marker) {
    color: var(--kin-deep);
  }
  .news-body :global(code) {
    background: var(--washi);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .news-body :global(pre) {
    margin-top: 1.25em;
    padding: 1em 1.25em;
    border-radius: 8px;
    overflow-x: auto;
  }
  .news-body :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .news-body :global(blockquote) {
    margin: 1.25em 0 0;
    padding: 0.8em 1.2em;
    border-left: 4px solid var(--kin);
    background: var(--washi);
    border-radius: 0 8px 8px 0;
  }
  .news-body :global(blockquote > :first-child) {
    margin-top: 0;
  }
  .news-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.5em 0;
  }
</style>
