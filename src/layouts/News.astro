---
import Layout from '~/layouts/2027Sub.astro';
import Prose from '~/components/2027/Prose.astro';
import type { NewsFrontmatter } from '~/types/news';

interface Props {
  frontmatter: NewsFrontmatter;
}

const { frontmatter } = Astro.props;

const pathWithSlash = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const shareUrl = Astro.site
  ? new URL(pathWithSlash, Astro.site).toString()
  : Astro.url.toString();
const shareIntent = `https://twitter.com/intent/tweet?text=${encodeURIComponent(
  frontmatter.title
)}&url=${encodeURIComponent(shareUrl)}&hashtags=burikaigi`;
---

<Layout
  name={frontmatter.title}
  ogTitle={frontmatter.title}
  ogType="article"
  ogDescription={frontmatter.summary}
  publishedTime={`${frontmatter.date}T00:00:00+09:00`}
>
  <article>
    <header class="article-head">
      <h1>{frontmatter.title}</h1>
      <time datetime={frontmatter.date}>{frontmatter.date.replaceAll('-', '.')}</time>
    </header>

    <Prose>
      <slot />
    </Prose>

    <footer class="article-foot">
      <a class="btn ghost" href="/news/">← お知らせ一覧</a>
      <a class="btn primary" href={shareIntent} target="_blank" rel="noopener noreferrer" aria-label="この記事を X でシェア">
        <img src="/images/x.svg" alt="" width="16" height="16" aria-hidden="true" />
        この記事をシェア
      </a>
    </footer>
  </article>
</Layout>

<style>
  /* 本文 17px で 1 行およそ 54 字（全角のみの段落で実測） */
  article {
    max-width: 840px;
    margin: 0 auto;
  }

  .article-head {
    padding-bottom: 24px;
    border-bottom: 2px solid var(--ai);
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(24px, 3.4vw, 36px);
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--ai);
  }
  time {
    display: block;
    margin-top: 12px;
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--kin-deep);
  }

  .article-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  /* 白抜きの X ロゴ */
  .article-foot img {
    width: 16px;
    height: 16px;
    filter: invert(1);
  }
</style>
