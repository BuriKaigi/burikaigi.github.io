---
import type { CollectionEntry } from 'astro:content';

type Props = {
  events: CollectionEntry<'events2027'>[];
};

const { events } = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<section class="paper" id="events">
  <div class="wrap">
    <h2 class="section-title">イベント・募集<span class="en">EVENTS</span></h2>
    <div class="cards">
      {
        events.map(({ data }) => (
          <article class:list={['card', data.accent]}>
            <span class="label">{data.label}</span>
            <h3>{data.title}</h3>
            <p>{data.description}</p>
            {data.link && (
              <a
                class:list={['btn', data.accent === 'kin' ? 'primary' : 'ghost']}
                href={data.link.href}
                target={isExternal(data.link.href) ? '_blank' : undefined}
                rel={isExternal(data.link.href) ? 'noopener noreferrer' : undefined}
              >
                {data.link.label}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .paper {
    padding-top: clamp(56px, 8vw, 104px);
  }
  .section-title {
    color: var(--ai);
  }
  .section-title .en {
    color: var(--kin-deep);
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 28px;
  }
  .card {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--ai);
    border-radius: 20px;
    padding: clamp(24px, 3vw, 36px);
    background: var(--shiro);
    min-height: 280px;
    display: flex;
    flex-direction: column;
  }
  .card .label {
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--kin-deep);
    font-weight: 700;
  }
  .card h3 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(22px, 2.4vw, 28px);
    color: var(--ai);
    margin: 6px 0 12px;
  }
  .card p {
    margin: 0 0 20px;
    font-size: 15px;
    max-width: 26em;
  }
  .card .btn {
    align-self: flex-start;
    margin-top: auto;
  }
  .card.kin {
    background: #fffaf0;
    border-color: var(--kin-deep);
  }
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
