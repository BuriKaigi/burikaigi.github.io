---
// お知らせ詳細・行動規範などの本文（見出し・段落・リスト・リンク・引用）の見た目
---

<div class="prose">
  <slot />
</div>

<style>
  /* 中の要素は Markdown などから生成されるので :global で当てる */
  .prose {
    font-size: 17px;
  }
  .prose :global(h2) {
    margin: 2.5em 0 0.8em;
    padding-left: 14px;
    border-left: 4px solid var(--kin);
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.5;
    color: var(--ai);
  }
  .prose :global(h3) {
    margin: 2em 0 0.6em;
    font-family: var(--display);
    font-weight: 800;
    font-size: 18px;
    color: var(--ai);
  }
  .prose :global(p) {
    margin: 1em 0 0;
    line-height: 1.95;
  }
  .prose :global(strong) {
    font-weight: 700;
    color: var(--ai);
  }
  .prose :global(a) {
    color: var(--ai);
    text-decoration: underline;
    text-decoration-color: var(--kin);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .prose :global(a:hover) {
    background: var(--washi);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1em 0 0;
    padding-left: 1.5em;
  }
  /* 入れ子のリストは li の margin-top だけで詰める */
  .prose :global(li > ul),
  .prose :global(li > ol) {
    margin-top: 0;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-top: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--kin-deep);
  }
  .prose :global(code) {
    background: var(--washi);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    margin-top: 1.25em;
    padding: 1em 1.25em;
    border-radius: 8px;
    overflow-x: auto;
  }
  .prose :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .prose :global(blockquote) {
    margin: 1.25em 0 0;
    padding: 0.8em 1.2em;
    border-left: 4px solid var(--kin);
    background: var(--washi);
    border-radius: 0 8px 8px 0;
  }
  .prose :global(blockquote > :first-child) {
    margin-top: 0;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.5em 0;
  }
</style>
