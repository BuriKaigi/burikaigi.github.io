---
import { User } from 'lucide-react';

// 「私たちについて」ページ（/about）で使うメンバー紹介カード。
export interface Member {
  /** 表示名 */
  name: string;
  /** 所属・肩書きなど（任意） */
  role?: string;
  /** アイコン画像パス（public 配下 例: '/images/2027/members/01.jpg'）。未指定ならプレースホルダ表示 */
  image?: string;
  /** X(Twitter) のユーザー名（@ は不要・任意） */
  x?: string;
  /** Facebook のユーザー名（任意） */
  facebook?: string;
  /** GitHub のユーザー名（任意） */
  github?: string;
  /** 役割区分。/about ではこの区分ごとに見出しを分けて並べる */
  group: 'core' | 'annual' | 'creative';
}

interface Props {
  member: Member;
}

const { member } = Astro.props;

// SNS リンク（X → Facebook → GitHub の順）。値が入っているものだけ表示する。
type Social = { label: string; href: string; icon: string };
const socials: Social[] = [
  member.x && { label: 'X', href: `https://x.com/${member.x}`, icon: '/images/x.svg' },
  member.facebook && {
    label: 'Facebook',
    href: `https://www.facebook.com/${member.facebook}`,
    icon: '/images/facebook.svg',
  },
  member.github && { label: 'GitHub', href: `https://github.com/${member.github}`, icon: '/images/github.svg' },
].filter((s): s is Social => Boolean(s));
---

<div class="member">
  <div class="avatar">
    {member.image ? (
      <img src={member.image} alt="" width="112" height="112" loading="lazy" />
    ) : (
      <User className="placeholder" aria-hidden="true" />
    )}
  </div>
  <p class="name">{member.name}</p>
  {member.role && <p class="role">{member.role}</p>}
  {socials.length > 0 && (
    <div class="socials">
      {socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} の ${social.label}`}>
          <img src={social.icon} alt="" width="16" height="16" aria-hidden="true" />
        </a>
      ))}
    </div>
  )}
</div>

<style>
  .member {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px 16px;
    border: 2px solid var(--ai);
    border-radius: 20px;
    background: var(--shiro);
  }
  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--washi);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar :global(.placeholder) {
    width: 40px;
    height: 40px;
    color: var(--ai);
    opacity: 0.4;
  }
  .name {
    margin: 14px 0 0;
    font-weight: 700;
    font-size: 16px;
    color: var(--ai);
  }
  .role {
    margin: 4px 0 0;
    font-size: 13px;
    opacity: 0.8;
  }
  .socials {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .socials a {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    transition: background 0.2s, border-color 0.2s;
  }
  .socials a:hover {
    background: var(--washi);
    border-color: var(--ai);
  }
  .socials img {
    width: 16px;
    height: 16px;
  }
</style>
