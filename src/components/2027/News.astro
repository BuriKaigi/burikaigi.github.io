---
import type { NewsItem } from '~/types/news';
import { resolveLink } from '~/types/news';

type Props = {
  news: NewsItem[];
};

const { news } = Astro.props;

// '2026-09-14' → '2026.09.14'
const formatDate = (iso: string) => iso.replaceAll('-', '.');
---

<section class="paper" id="news">
  <div class="wrap">
    <div class="head">
      <h2 class="section-title">お知らせ<span class="en">NEWS</span></h2>
      <a class="more" href="/news/">すべて見る →</a>
    </div>
    <ul class="news-list">
      {
        news.map((item) => {
          const { href, isExternal } = resolveLink(item);
          return (
            <li>
              <a
                href={href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
              >
                <time datetime={item.date}>{formatDate(item.date)}</time>
                <span class="t">
                  {item.title}
                  {isExternal && <span class="sr-only">（外部リンク）</span>}
                </span>
                <span class="arrow" aria-hidden="true">
                  {isExternal ? '↗' : '→'}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .paper {
    padding: clamp(56px, 8vw, 104px) 0 0;
  }
  .section-title {
    color: var(--ai);
  }
  .section-title .en {
    color: var(--kin-deep);
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .more {
    font-size: 14px;
    font-weight: 700;
    color: var(--ai);
    text-decoration: none;
    white-space: nowrap;
  }
  .more:hover {
    text-decoration: underline;
    text-decoration-color: var(--kin);
    text-underline-offset: 0.3em;
  }
  .news-list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    border-top: 2px solid var(--ai);
  }
  .news-list li {
    border-bottom: 1px solid var(--line);
  }
  .news-list a {
    display: grid;
    grid-template-columns: 120px 1fr 24px;
    gap: 20px;
    padding: 22px 4px;
    text-decoration: none;
    align-items: center;
    transition: background 0.2s, padding 0.2s;
  }
  .news-list a:hover {
    background: var(--washi);
    padding-left: 14px;
  }
  .news-list time {
    font-family: var(--display);
    font-weight: 800;
    color: var(--ai);
    letter-spacing: 0.05em;
  }
  .news-list .t {
    font-weight: 700;
  }
  .news-list .arrow {
    color: var(--kin-deep);
    font-weight: 700;
  }
  @media (max-width: 600px) {
    .news-list a {
      grid-template-columns: 1fr 20px;
      gap: 4px 12px;
    }
    .news-list time {
      grid-column: 1 / -1;
      font-size: 14px;
    }
  }
</style>
