---
import NewsList from '~/components/2027/NewsList.astro';
import type { NewsItem } from '~/types/news';

type Props = {
  news: NewsItem[];
};

const { news } = Astro.props;
---

<section class="paper" id="news">
  <div class="wrap">
    <div class="head">
      <h2 class="section-title">お知らせ</h2>
      <a class="more" href="/news/">すべて見る →</a>
    </div>
    <NewsList news={news} />
  </div>
</section>

<style>
  .paper {
    padding: clamp(56px, 8vw, 104px) 0 0;
  }
  .section-title {
    color: var(--ai);
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .more {
    font-size: 14px;
    font-weight: 700;
    color: var(--ai);
    text-decoration: none;
    white-space: nowrap;
  }
  .more:hover {
    text-decoration: underline;
    text-decoration-color: var(--kin);
    text-underline-offset: 0.3em;
  }
</style>
