---
import Layout from '~/layouts/2027.astro';
import Header from '~/components/2027/Header.astro';
import Hero from '~/components/2027/Hero.astro';
import Overview from '~/components/2027/Overview.astro';
import News from '~/components/2027/News.astro';
import Keynotes from '~/components/2027/Keynotes.astro';
import Events from '~/components/2027/Events.astro';
import Sponsors from '~/components/2027/Sponsors.astro';
import Footer from '~/components/2027/Footer.astro';
import { conference } from '~/data/2027/conference';
import { getEvents, getKeynotes, getSponsors } from '~/data/2027/content';
import type { NewsItem, NewsModule } from '~/types/news';

// `_` プレフィックスのファイルは Astro routing から除外されるため、TOP の
// 最新一覧側でも同じ規約で除外する（詳細なしのリンク出力を防ぐ）。
const allNews = Object.entries(
  import.meta.glob<NewsModule>('./news/*.md', { eager: true })
)
  .filter(([path]) => !/\/_[^/]+$/.test(path))
  .map(([, m]) => m);

const latestNews: NewsItem[] = allNews
  .map((m) => ({
    ...m.frontmatter,
    url: m.url.endsWith('/') ? m.url : `${m.url}/`,
  }))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const [keynotes, events, sponsors] = await Promise.all([getKeynotes(), getEvents(), getSponsors()]);

// データが 1 件もないセクションは、本文・ナビとも出さない
const sections = [
  { id: 'overview', label: '開催概要', visible: true },
  { id: 'news', label: 'お知らせ', visible: latestNews.length > 0 },
  { id: 'keynotes', label: '基調講演', visible: keynotes.length > 0 },
  { id: 'events', label: 'イベント', visible: events.length > 0 },
  { id: 'sponsors', label: 'スポンサー', visible: sponsors.length > 0 },
];
const shown = new Set(sections.filter((s) => s.visible).map((s) => s.id));
const nav = sections.filter((s) => s.visible).map((s) => ({ href: `#${s.id}`, label: s.label }));
---

<Layout title="2027" ogTitle="BuriKaigi 2027">
  <Header nav={nav} registrationUrl={conference.registrationUrl} />
  <main>
    <Hero />
    <Overview />
    {shown.has('news') && <News news={latestNews} />}
    {shown.has('keynotes') && <Keynotes keynotes={keynotes} />}
    {shown.has('events') && <Events events={events} />}
    {shown.has('sponsors') && <Sponsors sponsors={sponsors} />}
  </main>
  <Footer />
</Layout>
