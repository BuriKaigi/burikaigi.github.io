const groups: { id: Member['group']; label: string }[] = [
  { id: 'core', label: 'コアメンバー' },
  { id: 'annual', label: '年間運営スタッフ' },
  { id: 'creative', label: 'クリエイティブスタッフ' },
];
const sections = groups
  .map((g) => ({ ...g, members: members.filter((m) => m.group === g.id) }))
  .filter((g) => g.members.length > 0);
---

<Layout
  title="私たちについて"
  ogTitle="私たちについて | BuriKaigi"
  ogDescription="BuriKaigi を企画・運営する実行委員会のメンバー紹介です。コアメンバーと年間運営スタッフが力を合わせて、寒ブリの季節の北陸で開催しています。"
>
  <h1 class="section-title">私たちについて</h1>
  <p class="intro">
    BuriKaigi は、有志のメンバーが集まる<strong>実行委員会方式</strong>で運営しています。一人ひとりが力を合わせて、毎年の開催を作り上げています。BuriKaigi 2027 からは新たな取り組みとして、準備・企画の段階から関わる<strong>年間運営スタッフ</strong>を迎えています。
  </p>

  {
    sections.map((section) => (
      <section class="group" aria-labelledby={`group-${section.id}`}>
        <h2 id={`group-${section.id}`}>{section.label}</h2>
        <div class="members">
          {section.members.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      </section>
    ))
  }

  <p class="back"><a class="btn ghost" href="/">← トップに戻る</a></p>
</Layout>

<style>
  .section-title {
    color: var(--ai);
  }
  .intro {
    max-width: 840px;
    margin: 20px 0 0;
    font-size: 16px;
    line-height: 2;
  }
  .intro strong {
    color: var(--ai);
  }
  .group {
    margin-top: clamp(48px, 6vw, 72px);
  }
  /* 見出しの右に罫線を引く（スポンサーのプラン見出しと同じ） */
  .group h2 {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 20px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.06em;
    color: var(--ai);
  }
  .group h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .members {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }
  @media (max-width: 600px) {
    .members {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
  .back {
    margin: 72px 0 0;
    text-align: center;
  }
</style>
