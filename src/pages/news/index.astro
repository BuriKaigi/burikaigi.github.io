---
import Layout from '~/layouts/2027Sub.astro';
import NewsList from '~/components/2027/NewsList.astro';
import type { NewsItem, NewsModule } from '~/types/news';

// `_` プレフィックスのファイルは Astro routing から除外されるため、一覧側でも
// 同じ規約で除外しないと詳細ページなしのリンクが出てしまう（404 リンク化）。
const allNews = Object.entries(
  import.meta.glob<NewsModule>('./*.md', { eager: true })
)
  .filter(([path]) => !/\/_[^/]+$/.test(path))
  .map(([, m]) => m);

const news: NewsItem[] = allNews
  .map((m) => ({
    ...m.frontmatter,
    url: m.url.endsWith('/') ? m.url : `${m.url}/`,
  }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="お知らせ" ogTitle="お知らせ | BuriKaigi">
  <h1 class="section-title">お知らせ</h1>
  {news.length === 0 ? <p class="empty">お知らせはまだありません。</p> : <NewsList news={news} withSummary />}
  <p class="back"><a class="btn ghost" href="/">← トップに戻る</a></p>
</Layout>

<style>
  .section-title {
    color: var(--ai);
  }
  .empty {
    margin: 28px 0 0;
  }
  .back {
    margin: 56px 0 0;
    text-align: center;
  }
</style>
